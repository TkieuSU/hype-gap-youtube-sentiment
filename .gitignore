# Python bytecode
__pycache__/
*.py[cod]

# Virtual environments
venv/
env/
.venv/

# Environment / secrets
.env

# Jupyter Notebook checkpoints and outputs
.ipynb_checkpoints/

# Ignore notebook checkpoint files
*.ipynb_checkpoints

# Ignore common data files (remove these lines if you want CSVs in source control)
data/*.csv
data/*.parquet
data/*.h5

# macOS files
.DS_Store

# IDEs and editors
.vscode/
.idea/

# Logs and temporary files
*.log
*.tmp
tmp/

# Build / packaging
build/
dist/
*.egg-info/
.eggs/

# Coverage reports
.coverage
htmlcov/

# pytest cache
.pytest_cache/

# Python dependency files to ignore
Pipfile.lock

# Credentials / keys
*.pem
*.key

# OS thumbnail db
Thumbs.db